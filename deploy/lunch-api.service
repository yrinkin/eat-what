# 오늘 뭐 먹지? FastAPI 서비스 (PLAN T24)
# 설치는 deploy/deploy.sh가 한다. __APP_USER__, __BACKEND_DIR__은 설치할 때 바뀐다.
[Unit]
Description=Lunch API (FastAPI)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__BACKEND_DIR__
# 127.0.0.1에만 열어 외부에서 8000번으로 직접 접속할 수 없게 한다. 접속 정보는 backend/.env에서 읽는다.
ExecStart=__BACKEND_DIR__/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
